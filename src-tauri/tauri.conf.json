{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellistry",
  "version": "0.1.0",
  "identifier": "org.mdwell.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Vellistry", "width": 1200, "height": 820, "minWidth": 650, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": [{
        "identifier": "main",
        "windows": ["main"],
        "permissions": ["core:default", "dialog:allow-open", { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }] }]
      }]
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "category": "Productivity", "shortDescription": "Your documentation. Beautifully readable. Instantly searchable." }
}
